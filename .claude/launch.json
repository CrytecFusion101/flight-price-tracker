{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const r=p.join(process.cwd(),'docs');h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const fp=p.join(r,u);if(!fp.startsWith(r))return s.writeHead(403).end();f.readFile(fp,(e,d)=>{if(e)return s.writeHead(404).end();s.writeHead(200,{'Content-Type':fp.endsWith('.json')?'application/json':'text/html; charset=utf-8'});s.end(d)})}).listen(8765)"],
      "port": 8765
    }
  ]
}
